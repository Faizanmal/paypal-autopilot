# Copy to .env and fill in real values locally. Never commit the real .env.
# This file documents every variable the system reads; it intentionally
# contains no real secrets.

# ---- App ----
APP_ENV=development
# Required. At least 16 characters. Used to HMAC session cookie tokens.
SECRET_KEY=replace-with-a-long-random-string

# Comma-separated browser origins allowed to send cookies to the API.
# Required when APP_ENV=production (example: https://app.example.com).
CORS_ORIGINS=
# Optional public HTTPS API origin (documentation / webhook tips).
PUBLIC_API_BASE_URL=

# ---- Database (async + sync must target the SAME database name) ----
DATABASE_URL=postgresql+asyncpg://autopilot:autopilot@localhost:5433/autopilot
DATABASE_URL_SYNC=postgresql+psycopg://autopilot:autopilot@localhost:5433/autopilot

# ---- Redis (Celery broker/result + token cache; NEVER financial truth) ----
REDIS_URL=redis://localhost:6380/0
# Docker worker concurrency; Render Blueprint uses 1 for its small worker instance.
CELERY_WORKER_CONCURRENCY=2

# ---- PayPal (Sandbox ONLY for this project) ----
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the PayPal developer dashboard webhook subscription.
PAYPAL_WEBHOOK_ID=
# Optional override. Must be an official HTTPS API origin for PAYPAL_ENV.
# Sandbox: https://api-m.sandbox.paypal.com. Empty uses the selected default.
PAYPAL_API_BASE_URL=
PAYPAL_SANDBOX_BUSINESS_EMAIL=
# Invoice recipient email. For USD sandbox invoices, avoid India-region personal
# sandbox accounts (PayPal returns INR_FOREIGN_CURRENCY_BLOCKED on send). A plain
# example.com address works for create/send; pay via a US sandbox personal login
# on the hosted invoice page, or use record-payment + invoice sync for QA.
PAYPAL_SANDBOX_BUYER_EMAIL=
# Leave false until a live sandbox token includes the Payouts scope AND you
# intentionally authorize sending sandbox payouts.
PAYPAL_PAYOUTS_EXECUTION=false
# Must remain false for the hackathon. Blocks PAYPAL_ENV=live.
ALLOW_LIVE_PAYPAL=false

# Required sandbox app Features (Apps & Credentials → your Sandbox app):
#   - Invoicing  → token must include https://uri.paypal.com/services/invoicing
#   - Payouts    → token must include https://uri.paypal.com/payments/payouts
# After toggling Features, save, wait/propagate, restart the API (token cache).
# If the Features checkbox is on but scopes still fail, create a new Sandbox app.
# Check: cd apps/api && uv run python ../../scripts/check_paypal_scopes.py


# Webhook callback you will register in PayPal (HTTPS in any shared/demo host):
#   {PUBLIC_API_BASE_URL}/api/v1/webhooks/paypal
# Localhost cannot receive PayPal webhooks without a tunnel.

# ---- AI Provider ----
# auto | groq | gemini | openai | fallback_rules
# auto tries groq → gemini → openai (whichever keys are set), then rule-based fallback.
AI_PROVIDER=auto
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# AG Studio report chat uses this server-side model and OPENAI_API_KEY.
STUDIO_AI_MODEL=gpt-4o-mini
# Optional read-only Render Workflows report. Never expose this key to browsers.
RENDER_API_KEY=
RENDER_REPORT_TASK=
# Local task server only; must remain false/empty in production.
RENDER_USE_LOCAL_DEV=false
RENDER_LOCAL_DEV_URL=

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Used by Next server rewrites inside Docker/prod networking.
API_INTERNAL_BASE_URL=http://127.0.0.1:8000
# Optional browser-visible commercial/trial licence; never put an API key here.
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=

# ---- Docker Compose host ports (containers keep internal ports) ----
POSTGRES_USER=autopilot
POSTGRES_PASSWORD=autopilot
POSTGRES_DB=autopilot
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
API_HOST_PORT=8000
WEB_HOST_PORT=3000
